# Frontend (Vercel)
# Use the public HTTPS origin of your deployed Spring Boot API.
# The frontend automatically appends /api when needed.
VITE_API_URL=https://your-backend.example.com
VITE_DEMO_MODE=false

# Backend / Docker
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_CORS_ALLOWED_ORIGINS=https://rkvalley.vercel.app
APP_JWT_EXPIRATION_MS=86400000
