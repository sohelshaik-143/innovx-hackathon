# CampusClear - Production & Local Development Environment Variables

# ==================================================
# FRONTEND CONFIGURATION (Vercel / Vite)
# ==================================================
# Base URL for Render backend Spring Boot API
VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com/api

# Enable evaluation demo user quick-switcher (set to false for production)
VITE_DEMO_MODE=false

# Application metadata
VITE_APP_NAME=CampusClear
VITE_APP_TITLE=RGUKT No-Dues Clearance Portal

# ==================================================
# BACKEND CONFIGURATION (Render / Spring Boot)
# ==================================================
# Active Spring Profile (prod for Render / PostgreSQL, dev for local H2)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render dynamically assigns PORT, default 10000 / 8080)
PORT=10000

# Security - Cryptographically Strong JWT Secret (min 256-bit / 64 hex chars)
APP_JWT_SECRET=YOUR_64_CHAR_HEX_SECRET_OR_RENDER_GENERATED_JWT_SECRET

# JWT Expiration in Milliseconds (86400000 = 24 hours)
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated Vercel frontend domains)
APP_CORS_ALLOWED_ORIGINS=https://rkvalley.vercel.app,http://localhost:5173

# ==================================================
# DATABASE CONFIGURATION (Render PostgreSQL)
# ==================================================
DB_HOST=dpg-xxxxxxxxxxxx-a.singapore-postgres.render.com
DB_PORT=5432
DB_NAME=nodues_db
DB_USER=nodues_user
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
